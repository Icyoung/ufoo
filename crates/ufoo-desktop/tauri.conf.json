{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ufoo",
  "mainBinaryName": "Ufoo",
  "version": "5.0.1",
  "identifier": "dev.ufoo.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../apps/desktop run dev",
    "beforeBuildCommand": "npm --prefix ../apps/desktop run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ufoo",
        "width": 1380,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
