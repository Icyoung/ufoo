{
  "schema_version": 1,
  "template": {
    "id": "ui-polish",
    "alias": "ui-polish",
    "name": "UI Polish",
    "description": "UI execution lane: audit, apply focused frontend polish, and verify UX regressions."
  },
  "defaults": {
    "launch_mode": "auto",
    "start_timeout_ms": 15000
  },
  "agents": [
    {
      "id": "designer",
      "nickname": "designer",
      "type": "auto",
      "role": "audit the interface and rank design polish issues",
      "prompt_profile": "design-critic",
      "accept_from": [
        "refiner",
        "qa"
      ],
      "report_to": [
        "refiner",
        "qa"
      ],
      "startup_order": 1,
      "depends_on": [],
      "model_config": {
        "codex": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "xhigh"
        },
        "claude": {
          "model": "claude-opus-5-5",
          "reasoning_effort": ""
        },
        "agy": {
          "model": "gemini-4-argon-high",
          "reasoning_effort": ""
        },
        "override": {
          "model": "",
          "reasoning_effort": ""
        }
      }
    },
    {
      "id": "refiner",
      "nickname": "refiner",
      "type": "auto",
      "role": "implement focused UI and interaction refinements",
      "prompt_profile": "frontend-refiner",
      "accept_from": [
        "designer",
        "qa"
      ],
      "report_to": [
        "qa"
      ],
      "startup_order": 2,
      "depends_on": [
        "designer"
      ],
      "model_config": {
        "codex": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "high"
        },
        "claude": {
          "model": "claude-opus-5-5",
          "reasoning_effort": ""
        },
        "agy": {
          "model": "gemini-4-hydrogen-high",
          "reasoning_effort": ""
        },
        "override": {
          "model": "",
          "reasoning_effort": ""
        }
      }
    },
    {
      "id": "qa",
      "nickname": "qa",
      "type": "auto",
      "role": "validate polish changes and catch UX regressions",
      "prompt_profile": "qa-driver",
      "accept_from": [
        "designer",
        "refiner"
      ],
      "report_to": [
        "refiner"
      ],
      "startup_order": 3,
      "depends_on": [
        "designer",
        "refiner"
      ],
      "model_config": {
        "codex": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "xhigh"
        },
        "claude": {
          "model": "claude-opus-5-5",
          "reasoning_effort": ""
        },
        "agy": {
          "model": "gemini-4-hydrogen-high",
          "reasoning_effort": ""
        },
        "override": {
          "model": "",
          "reasoning_effort": ""
        }
      }
    }
  ],
  "edges": [
    {
      "from": "designer",
      "to": "refiner",
      "kind": "task"
    },
    {
      "from": "designer",
      "to": "qa",
      "kind": "review"
    },
    {
      "from": "refiner",
      "to": "qa",
      "kind": "task"
    },
    {
      "from": "qa",
      "to": "refiner",
      "kind": "review"
    }
  ]
}
