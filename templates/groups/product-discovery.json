{
  "schema_version": 1,
  "template": {
    "id": "product-discovery",
    "alias": "product-discovery",
    "name": "Product Discovery Plan",
    "description": "Pre-implementation discovery lane that turns vague product intent into a scoped technical plan; it does not implement."
  },
  "defaults": {
    "launch_mode": "auto",
    "start_timeout_ms": 15000
  },
  "agents": [
    {
      "id": "facilitator",
      "nickname": "facilitator",
      "type": "auto",
      "role": "clarify the real problem and define a narrow wedge",
      "prompt_profile": "discovery-facilitator",
      "accept_from": [
        "challenger",
        "architect"
      ],
      "report_to": [
        "challenger",
        "architect"
      ],
      "startup_order": 1,
      "depends_on": [],
      "model_config": {
        "codex": {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        },
        "claude": {
          "model": "claude-fable-5-2",
          "reasoning_effort": ""
        },
        "agy": {
          "model": "gemini-4-carbon-high",
          "reasoning_effort": ""
        },
        "override": {
          "model": "",
          "reasoning_effort": ""
        }
      }
    },
    {
      "id": "challenger",
      "nickname": "challenger",
      "type": "auto",
      "role": "challenge scope and leverage",
      "prompt_profile": "scope-challenger",
      "accept_from": [
        "facilitator",
        "architect"
      ],
      "report_to": [
        "architect"
      ],
      "startup_order": 2,
      "depends_on": [
        "facilitator"
      ],
      "model_config": {
        "codex": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "xhigh"
        },
        "claude": {
          "model": "claude-opus-5-5",
          "reasoning_effort": ""
        },
        "agy": {
          "model": "gemini-4-argon-high",
          "reasoning_effort": ""
        },
        "override": {
          "model": "",
          "reasoning_effort": ""
        }
      }
    },
    {
      "id": "architect",
      "nickname": "architect",
      "type": "auto",
      "role": "translate approved scope into an execution-ready technical plan, not code",
      "prompt_profile": "system-architect",
      "accept_from": [
        "facilitator",
        "challenger"
      ],
      "report_to": [],
      "startup_order": 3,
      "depends_on": [
        "facilitator",
        "challenger"
      ],
      "model_config": {
        "codex": {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        },
        "claude": {
          "model": "claude-fable-5-2",
          "reasoning_effort": ""
        },
        "agy": {
          "model": "gemini-4-carbon-high",
          "reasoning_effort": ""
        },
        "override": {
          "model": "",
          "reasoning_effort": ""
        }
      }
    }
  ],
  "edges": [
    {
      "from": "facilitator",
      "to": "challenger",
      "kind": "task"
    },
    {
      "from": "facilitator",
      "to": "architect",
      "kind": "task"
    },
    {
      "from": "challenger",
      "to": "architect",
      "kind": "review"
    }
  ]
}
